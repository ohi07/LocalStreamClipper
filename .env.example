# No paid API key is needed to create clips.
WHISPER_MODEL=auto
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=auto
OLLAMA_ENABLED=false
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
CLIP_COUNT=5
CLIP_SECONDS=45
CLIP_MIN_SECONDS=20
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
EXPORT_PRESET=veryfast
CROP_MODE=blur
CAPTIONS=true
# Optional: a Netscape-format cookie file you exported yourself, for authorized access.
YTDLP_COOKIES_FILE=
# Optional YouTube uploads. Keep secrets local; never put them in git.
YOUTUBE_CLIENT_SECRETS=client_secrets.json
YOUTUBE_PRIVACY=private
